      "name": "臺中彰化_36小時預報"
    },
    {
      "parameters": {
        "jsCode": "// N8N Code Node - 整理天氣預報資料\nconst input = $input.first().json;\n\nconst locations = input.records.location;\nconst results = [];\n\nfor (const loc of locations) {\n  const locationName = loc.locationName;\n\n  // 先把各 elementName 的 time 陣列整理成 map: { startTime_endTime: {...} }\n  const timeMap = {};\n\n  for (const element of loc.weatherElement) {\n    const elementName = element.elementName; // Wx, PoP, MinT, CI, MaxT...\n\n    for (const t of element.time) {\n      const key = `${t.startTime}__${t.endTime}`;\n\n      if (!timeMap[key]) {\n        timeMap[key] = {\n          locationName,\n          startTime: t.startTime,\n          endTime: t.endTime,\n        };\n      }\n\n      // 依照 elementName 塞值\n      if (elementName === \"Wx\") {\n        timeMap[key].weather = t.parameter.parameterName; // 天氣現象文字\n        timeMap[key].weatherCode = t.parameter.parameterValue; // 天氣代碼\n      } else if (elementName === \"PoP\") {\n        timeMap[key].rainProbability = t.parameter.parameterName; // 降雨機率(%)\n      } else if (elementName === \"MinT\") {\n        timeMap[key].minTemp = t.parameter.parameterName; // 最低溫\n      } else if (elementName === \"MaxT\") {\n        timeMap[key].maxTemp = t.parameter.parameterName; // 最高溫\n      } else if (elementName === \"CI\") {\n        timeMap[key].comfort = t.parameter.parameterName; // 舒適度\n      }\n    }\n  }\n\n  // 把 map 轉成陣列,加進總結果\n  for (const key in timeMap) {\n    results.push(timeMap[key]);\n  }\n}\n\n// 回傳給下一個 node,每筆資料是一個 item\nreturn results.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        -32
      ],
      "id": "efd9ba79-9970-459c-a5af-502bca775e47",
      "name": "Code in JavaScript"
    }
